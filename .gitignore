# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# artefatos de inspeção do navegador (Playwright MCP)
/.playwright-mcp/

# cache de ferramentas locais
/.impeccable/

# typescript
*.tsbuildinfo
next-env.d.ts

# Os PDFs dos livros. O repositório é público e livro comprado não pode ser
# redistribuído — eles ficam só na máquina do autor. O que o repositório
# versiona é a *proveniência* (livro, edição, página, diagrama), nunca a obra.
# O README é a exceção: ele explica a regra para quem clonar o projeto.
biblioteca/*
!biblioteca/README.md
